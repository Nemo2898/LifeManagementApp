<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LifeManagementApp.ViewModels"
        xmlns:models="using:LifeManagementApp.Models"
        x:Class="LifeManagementApp.Views.TodosWindow"
        x:DataType="vm:TodosViewModel"
        Title="Todos" Width="560" Height="460">

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <Button Content="➕ Add todo" Click="Add_Click"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="✏ Edit selected" Click="Edit_Click"/>
                <Button Content="✔ Mark done" Click="Done_Click"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="Red"/>
        </StackPanel>

        <ListBox x:Name="ItemsList" Margin="0,12,0,0" ItemsSource="{Binding Todos}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TodoItem}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}"/>
                        <TextBlock Text="{Binding Priority, StringFormat='P{0}'}" Foreground="Gray"/>
                        <TextBlock Text="{Binding DueDate, StringFormat=yyyy-MM-dd}" Foreground="Gray"/>
                        <TextBlock Text="✔" IsVisible="{Binding IsDone}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
