<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LifeManagementApp.ViewModels"
        x:Class="LifeManagementApp.Views.EditTodoWindow"
        x:DataType="vm:EditTodoViewModel"
        Title="Edit todo" Width="380" SizeToContent="Height">

    <StackPanel Margin="16" Spacing="10">
        <TextBox Watermark="Title (must not be empty)" Text="{Binding Title}"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Priority (1 = highest):" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding Priority}" Minimum="1" Maximum="5" Width="120" Increment="1"/>
        </StackPanel>

        <DatePicker SelectedDate="{Binding DueDate}"/>

        <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

        <Button Content="Save" Click="Save_Click" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
